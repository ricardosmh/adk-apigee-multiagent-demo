<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
  <Description/>
  <FaultRules/>
  <PreFlow name="PreFlow">
    <Request>
      <Step>
        <Name>CORS-AllowBrowserRequests</Name>
      </Step>
      <Step>
        <Name>VA-verify-x-api-key</Name>
        <Condition>(request.verb != "OPTIONS")</Condition>
      </Step>
    </Request>
    <Response/>
  </PreFlow>
  <PostFlow name="PostFlow">
    <Request/>
    <Response/>
  </PostFlow>
  <Flows/>
  <PostClientFlow name="PostClientFlow">
    <Request/>
    <Response>
      <Step>
        <Name>ML-interaction</Name>
      </Step>
    </Response>
  </PostClientFlow>
  <HTTPProxyConnection>
    <BasePath>/mcp</BasePath>
    <Properties/>
  </HTTPProxyConnection>
  <RouteRule name="default">
    <TargetEndpoint>default</TargetEndpoint>
  </RouteRule>
  <RouteRule name="default"/>
</ProxyEndpoint>
