<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<TargetEndpoint name="te-gemini-llm">
  <Description/>
  <FaultRules/>
  <PreFlow name="PreFlow">
    <Request>
      <Step>
        <Name>AM-PathSuffixFalse</Name>
      </Step>
    </Request>
    <Response>
    </Response>
  </PreFlow>
  <PostFlow name="PostFlow">
    <Request>
      <Step>
        <Name>am-clean-headers</Name>
      </Step>
      <Step>
        <Name>DC-capture-model</Name>
      </Step>
      <Step>
        <Name>LTQ-enforce</Name>
      </Step>
    </Request>
    <Response/>
  </PostFlow>
  <Flows>
    <Flow name="gemini-3.1-flash-lite">
      <Description/>
      <Request>
        <Step>
          <Name>AM-set-flash-model</Name>
        </Step>
      </Request>
      <Response/>
      <Condition>(request.header.complexity = "low") and (request.verb = "POST")</Condition>
    </Flow>
    <Flow name="gemini-3.1-pro-preview">
      <Description/>
      <Request>
        <Step>
          <Name>AM-set-gemini-3.1-pro-preview-model</Name>
        </Step>
      </Request>
      <Response/>
      <Condition>(request.header.complexity = "high") and (request.verb = "POST")</Condition>
    </Flow>
  </Flows>
  <EventFlow name="EventFlow" content-type="text/event-stream">
    <Response>
      <Step>
        <Name>JS-extract-tokens</Name>
      </Step>
      <Step>
        <Name>DC-capture-tokencount</Name>
        <Condition>isFinal = true</Condition>
      </Step>
      <Step>
        <Name>LTQ-count</Name>
        <Condition>isFinal = true</Condition>
      </Step>
    </Response>
  </EventFlow>
  <HTTPTargetConnection>
    <LoadBalancer>
      <Server name="ts-aiplatform-api"/>
    </LoadBalancer>
    <Properties>
      <Property name="io.timeout.millis">120000</Property>
      <Property name="response.streaming.enabled">true</Property>
    </Properties>
    <Path>/v1/projects/__AI_PROJECT__/locations/global/publishers/google/models/{dynamic_model}:streamGenerateContent?alt=sse</Path>
    <Authentication>
      <GoogleAccessToken>
        <Scopes>
          <Scope>https://www.googleapis.com/auth/cloud-platform</Scope>
        </Scopes>
      </GoogleAccessToken>
    </Authentication>
  </HTTPTargetConnection>
</TargetEndpoint>
