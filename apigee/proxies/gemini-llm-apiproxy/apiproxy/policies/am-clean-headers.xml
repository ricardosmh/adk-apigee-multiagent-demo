<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage continueOnError="false" enabled="true" name="am-clean-headers">
  <DisplayName>am-clean-headers</DisplayName>
  <Properties/>
  <Remove>
    <Headers>
      <Header name="x-api-key"/>
      <Header name="x-user-email"/>
      <Header name="publisher"/>
      <Header name="complexity"/>
    </Headers>
  </Remove>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
  <AssignTo createNew="false" transport="http" type="request"/>
</AssignMessage>
