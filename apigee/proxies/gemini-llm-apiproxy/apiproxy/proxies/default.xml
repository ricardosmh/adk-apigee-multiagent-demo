<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
  <Description/>
  <FaultRules/>
  <PreFlow name="PreFlow">
    <Request>
      <Step>
        <Name>VA-VerifyAPIKey</Name>
      </Step>
      <Step>
        <Name>DC-capture-user</Name>
      </Step>
      <Step>
        <Name>AM-set-user-var</Name>
      </Step>
      <Step>
        <Name>EV-ExtractRequest</Name>
      </Step>
      <Step>
        <Name>JS-strip-part-metadata</Name>
      </Step>
      <Step>
        <Name>DC-capture-model</Name>
      </Step>
      <Step>
        <Name>LTQ-enforce</Name>
      </Step>
      <Step>
        <Name>am-clean-headers</Name>
      </Step>
    </Request>
    <Response/>
  </PreFlow>
  <PostFlow name="PostFlow">
    <Request/>
    <Response/>
  </PostFlow>
  <Flows>
    <Flow name="trigger_gemini_model">
      <Description/>
      <Request/>
      <Response/>
      <Condition>(proxy.pathsuffix MatchesPath "/models/{modelId}:streamGenerateContent") and (request.verb = "POST")</Condition>
    </Flow>
  </Flows>
  <EventFlow name="EventFlow" content-type="text/event-stream">
    <Response/>
  </EventFlow>
  <HTTPProxyConnection>
    <BasePath>/aiplatform/v1beta</BasePath>
    <Properties>
      <Property name="response.streaming.enabled">true</Property>
    </Properties>
  </HTTPProxyConnection>
  <RouteRule name="te-gemini">
    <TargetEndpoint>te-gemini-llm</TargetEndpoint>
  </RouteRule>
  <PostClientFlow name="PostClientFlow">
    <Response>
      <Step>
        <Name>ML-interaction</Name>
      </Step>
    </Response>
  </PostClientFlow>
</ProxyEndpoint>
