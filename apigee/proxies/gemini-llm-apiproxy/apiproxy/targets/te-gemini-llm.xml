<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<TargetEndpoint name="te-gemini-llm">
  <Description/>
  <FaultRules/>
  <PreFlow name="PreFlow">
    <Request>
    </Request>
    <Response>
    </Response>
  </PreFlow>
  <PostFlow name="PostFlow">
    <Request>
    </Request>
    <Response>
      <!-- Non-streaming (generateContent) path: application/json body, so the
           SSE EventFlow below is bypassed. Meter the sub-agent calls here.
           Guarded to json only so it never reads/buffers an event-stream. -->
      <Step>
        <Name>EV-ExtractTokenCount</Name>
        <Condition>(response.header.Content-Type ~~ "(?i)application/json.*")</Condition>
      </Step>
      <Step>
        <Name>DC-capture-tokencount</Name>
        <Condition>(response.header.Content-Type ~~ "(?i)application/json.*")</Condition>
      </Step>
      <Step>
        <Name>LTQ-count</Name>
        <Condition>(response.header.Content-Type ~~ "(?i)application/json.*")</Condition>
      </Step>
    </Response>
  </PostFlow>
  <Flows>
  </Flows>
  <EventFlow name="EventFlow" content-type="text/event-stream">
    <Response>
      <Step>
        <Name>JS-extract-tokens</Name>
      </Step>
      <Step>
        <Name>DC-capture-tokencount</Name>
        <Condition>isFinal = true</Condition>
      </Step>
      <Step>
        <Name>LTQ-count</Name>
        <Condition>isFinal = true</Condition>
      </Step>
    </Response>
  </EventFlow>
  <HTTPTargetConnection>
    <LoadBalancer>
      <Server name="ts-aiplatform-api"/>
    </LoadBalancer>
    <Properties>
      <Property name="io.timeout.millis">120000</Property>
      <Property name="response.streaming.enabled">true</Property>
    </Properties>
    <Path>/v1/projects/__AI_PROJECT__/locations/global/publishers/google</Path>
    <Authentication>
      <GoogleAccessToken>
        <Scopes>
          <Scope>https://www.googleapis.com/auth/cloud-platform</Scope>
        </Scopes>
      </GoogleAccessToken>
    </Authentication>
  </HTTPTargetConnection>
</TargetEndpoint>
