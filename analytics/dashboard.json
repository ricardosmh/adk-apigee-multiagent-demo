{
  "displayName": "AI Analytics — tokens · quota · latency · faults",
  "mosaicLayout": {
    "columns": 12,
    "tiles": [
      {
        "xPos": 0, "yPos": 0, "width": 6, "height": 4,
        "widget": {
          "title": "Calls / min by model",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"logging.googleapis.com/user/ai_llm_calls\" AND resource.type=\"api\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_DELTA",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": ["metric.label.\"model\""]
                    }
                  }
                },
                "plotType": "STACKED_BAR"
              }
            ],
            "yAxis": { "label": "calls/min", "scale": "LINEAR" }
          }
        }
      },
      {
        "xPos": 6, "yPos": 0, "width": 6, "height": 4,
        "widget": {
          "title": "Total tokens by model",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesQueryLanguage": "fetch api | metric 'logging.googleapis.com/user/ai_tokens_total' | align delta(1m) | group_by [metric.model], [tokens: sum(val())]"
                },
                "plotType": "STACKED_BAR"
              }
            ],
            "yAxis": { "label": "tokens", "scale": "LINEAR" }
          }
        }
      },

      {
        "xPos": 0, "yPos": 4, "width": 6, "height": 4,
        "widget": {
          "title": "Avg tokens / call by model",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"logging.googleapis.com/user/ai_tokens_total\" AND resource.type=\"api\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_DELTA",
                      "crossSeriesReducer": "REDUCE_MEAN",
                      "groupByFields": ["metric.label.\"model\""]
                    }
                  }
                },
                "plotType": "LINE"
              }
            ],
            "yAxis": { "label": "tokens/call", "scale": "LINEAR" }
          }
        }
      },
      {
        "xPos": 6, "yPos": 4, "width": 6, "height": 4,
        "widget": {
          "title": "Operation latency p95 by type (ms)",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"logging.googleapis.com/user/ai_latency_ms\" AND metric.label.event!=\"turn\" AND metric.label.event!=\"agent_turn\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_PERCENTILE_95",
                      "crossSeriesReducer": "REDUCE_MEAN",
                      "groupByFields": ["metric.label.\"event\""]
                    }
                  }
                },
                "plotType": "LINE"
              }
            ],
            "yAxis": { "label": "ms", "scale": "LINEAR" }
          }
        }
      },

      {
        "xPos": 0, "yPos": 8, "width": 6, "height": 4,
        "widget": {
          "title": "Model usage mix (calls)",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"logging.googleapis.com/user/ai_llm_calls\" AND resource.type=\"api\"",
                    "aggregation": {
                      "alignmentPeriod": "300s",
                      "perSeriesAligner": "ALIGN_DELTA",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": ["metric.label.\"model\""]
                    }
                  }
                },
                "plotType": "STACKED_AREA"
              }
            ],
            "yAxis": { "label": "calls", "scale": "LINEAR" }
          }
        }
      },
      {
        "xPos": 6, "yPos": 8, "width": 6, "height": 4,
        "widget": {
          "title": "Gateway faults / min by proxy",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"logging.googleapis.com/user/ai_gateway_faults\" AND resource.type=\"api\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_DELTA",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": ["metric.label.\"proxy\""]
                    }
                  }
                },
                "plotType": "STACKED_BAR"
              }
            ],
            "yAxis": { "label": "faults/min", "scale": "LINEAR" }
          }
        }
      },

      {
        "xPos": 0, "yPos": 12, "width": 6, "height": 4,
        "widget": {
          "title": "Input vs output tokens / call",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"logging.googleapis.com/user/ai_input_tokens\" AND resource.type=\"api\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_DELTA",
                      "crossSeriesReducer": "REDUCE_MEAN"
                    }
                  }
                },
                "plotType": "STACKED_BAR",
                "legendTemplate": "input tokens/call"
              },
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"logging.googleapis.com/user/ai_output_tokens\" AND resource.type=\"api\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_DELTA",
                      "crossSeriesReducer": "REDUCE_MEAN"
                    }
                  }
                },
                "plotType": "STACKED_BAR",
                "legendTemplate": "output tokens/call"
              }
            ],
            "yAxis": { "label": "tokens/call", "scale": "LINEAR" }
          }
        }
      },
      {
        "xPos": 6, "yPos": 12, "width": 6, "height": 4,
        "widget": {
          "title": "Thinking tokens / call by model",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"logging.googleapis.com/user/ai_thinking_tokens\" AND resource.type=\"api\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_DELTA",
                      "crossSeriesReducer": "REDUCE_MEAN",
                      "groupByFields": ["metric.label.\"model\""]
                    }
                  }
                },
                "plotType": "LINE"
              }
            ],
            "yAxis": { "label": "tokens/call", "scale": "LINEAR" }
          }
        }
      },

      {
        "xPos": 0, "yPos": 16, "width": 12, "height": 4,
        "widget": {
          "title": "Gateway error rate (faults / calls)",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesFilterRatio": {
                    "numerator": {
                      "filter": "metric.type=\"logging.googleapis.com/user/ai_gateway_faults\" AND resource.type=\"api\"",
                      "aggregation": { "alignmentPeriod": "300s", "perSeriesAligner": "ALIGN_DELTA", "crossSeriesReducer": "REDUCE_SUM" }
                    },
                    "denominator": {
                      "filter": "metric.type=\"logging.googleapis.com/user/ai_llm_calls\" AND resource.type=\"api\"",
                      "aggregation": { "alignmentPeriod": "300s", "perSeriesAligner": "ALIGN_DELTA", "crossSeriesReducer": "REDUCE_SUM" }
                    }
                  }
                },
                "plotType": "LINE",
                "legendTemplate": "fault ratio"
              }
            ],
            "yAxis": { "label": "faults / call", "scale": "LINEAR" }
          }
        }
      }
    ]
  }
}
