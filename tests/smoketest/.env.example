# Apigee LLM smoke-test config. Copy to .env (gitignored) and fill in.

# Proxy base URL = scheme://host + deployed base path (NO version/model).
# The SDK appends /<version>/models/<model>:generateContent itself.
APIGEE_LLM_PROXY_URL=https://34.160.0.69.nip.io/aiplatform

# The Apigee API key (x-api-key). This is the only real credential needed.
APIGEE_API_KEY=

# Gemini model id served by the proxy's Vertex target.
APIGEE_LLM_MODEL=gemini-3.1-flash-lite

# API-version path segment the SDK inserts ({proxy}/<version>/models/...).
# Leave as v1beta for Gemini mode; set empty to drop it (proxy-dependent).
APIGEE_LLM_API_VERSION=v1beta

# nip.io serves a cert that won't validate locally — skip TLS verify here.
# Set to false once the proxy is on a real hostname with a valid cert.
APIGEE_LLM_INSECURE_TLS=true

# NOT an auth credential — Apigee authenticates to Vertex itself. The genai
# SDK simply refuses to build a Gemini-mode client unless *some* key is set, so
# this dummy only satisfies that check; its value is never used (it rides along
# as a meaningless x-goog-api-key the proxy can ignore/strip).
GOOGLE_API_KEY=unused-dummy-key
